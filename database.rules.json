{
  "rules": {
    "duelists": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['alias', 'login'])"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "backups": {
      "$phone": {
        ".read": "auth != null && auth.uid === $phone",
        ".write": "auth != null && auth.uid === $phone"
      }
    }
  }
}
